{{!-- A sidebar that allows creating new threads and switching to past threads --}}
<nav class="flex flex-col bg-dusk h-full w-64 border-r border-dusk-90 p-4">
  <h2 class="text-lg font-semibold mb-4 text-white">Document agent</h2>
  <ul class="my-2 list-none">
    <li class="truncate cursor-pointer rounded bg-dusk-90">
      <div class="block w-full p-2 text-left text-white">
      Projects
      </div>
    </li>
    <li class="truncate cursor-pointer rounded hover:bg-dusk-90 active:bg-dusk-90">
      <a href="/chat" class="block w-full p-2 text-left text-dusk-30">
      Chat
      </a>
    </li>
  </ul>
  <ul class="my-2 list-none">
    <li class="truncate cursor-pointer rounded hover:bg-dusk-90 active:bg-dusk-90">
        <form ws-send hx-disabled-elt="this" class="block w-full">
            <input type="hidden" name="cmd" value="projects/new" />
            <button type="submit" class="block w-full p-2 text-left text-dusk-30">
            + New project
            </button>
        </form>
    </li>
  </ul>
  <p class="text-sm text-dusk-50 my-2">Project list</p>
  <ul id="sidebarProjects">
    {{> projects/sidebar/projects }}
  </ul>
  <div class="grow"></div>
  <ul>
      <li class="text-xs cursor-pointer">
          <form ws-send hx-disabled-elt="this" hx-on:submit="setTimeout(location.reload.bind(location), 500)" class="block w-full">
              <input type="hidden" name="cmd" value="users/new" />
              <button type="submit" class="block w-full p-2 text-left text-dusk-30 hover:bg-dusk-90 active:bg-dusk-90">
                  + New session
              </button>
          </form>
      </li>
      <li class="text-xs cursor-pointer">
          <form ws-send hx-disabled-elt="this" hx-on:submit="setTimeout(location.reload.bind(location), 500)" class="block w-full">
              <input type="hidden" name="cmd" value="projects/clear" />
              <button type="submit" class="block w-full p-2 text-left text-dusk-30 hover:bg-dusk-90 active:bg-dusk-90">
                  Reset projects
              </button>
          </form>
      </li>
      <li class="text-xs cursor-pointer">
          <form ws-send hx-disabled-elt="this" hx-on:submit="setTimeout(location.reload.bind(location), 500)" class="block w-full">
              <input type="hidden" name="cmd" value="data/clear" />
              <button type="submit" class="block w-full p-2 text-left text-hyper-04 hover:text-white hover:bg-hyper-09 active:bg-hyper-09">
                  Reset session
              </button>
          </form>
      </li>
  </ul>
</nav>
