<div hx-swap-oob="outerHTML:#content-body" id="content-body" class="mt-3 flex w-full max-w-2/3 items-center justify-center rounded-t-lg bg-transparent pb-4">
{{#if projectId}}
    <form
        ws-send
        hx-on:submit="setTimeout(this.reset.bind(this), 200)"
        class="w-full items-center space-x-2"
        hx-disabled-elt="this"
    >
        <input type="hidden" name="cmd" value="projects/start" />
        <input type="hidden" name="projectId" value="{{projectId}}" />
        <div class="mb-2">
          <label for="title" class="text-dusk-10">Project title: </label>
          <input name="title" class="bg-dusk-90 text-white border border-dusk-50 rounded" type="text" required value="{{title}}" />
        </div>
        <div class="flex w-full flex-col items-center justify-center overflow-clip bg-dusk-90 border border-dusk-50 rounded-[28px]">
            <div class="relative flex w-full items-end px-2.5 py-4">
                <div class="relative flex w-full flex-auto flex-col">
                    <textarea
                        id="prompt"
                        name="prompt"
                        rows="5"
                        hx-on:keydown="submitPrompt(event)"
                        required
                        minlength="1"
                        placeholder="Describe the docs or editing goal. In local demo mode, bundled docs will load into Redis."
                        class="outline-none py-2 text-lg bg-transparent text-white placeholder-dusk-50"
                    ></textarea>
                    <button type="submit" aria-label="Send prompt" class="btn-icon self-end">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" class="icon"><path d="M8.99992 16V6.41407L5.70696 9.70704C5.31643 10.0976 4.68342 10.0976 4.29289 9.70704C3.90237 9.31652 3.90237 8.6835 4.29289 8.29298L9.29289 3.29298L9.36907 3.22462C9.76184 2.90427 10.3408 2.92686 10.707 3.29298L15.707 8.29298L15.7753 8.36915C16.0957 8.76192 16.0731 9.34092 15.707 9.70704C15.3408 10.0732 14.7618 10.0958 14.3691 9.7754L14.2929 9.70704L10.9999 6.41407V16C10.9999 16.5523 10.5522 17 9.99992 17C9.44764 17 8.99992 16.5523 8.99992 16Z"></path></svg>
                    </button>
                </div>
            </div>
        </div>
    </form>
{{/if}}
</div>
