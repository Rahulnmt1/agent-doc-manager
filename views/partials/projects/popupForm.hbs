<div hx-swap-oob="innerHTML:#popupContainer">
{{#if show}}
<div class="fixed inset-0 w-full bg-midnight/60 flex justify-center items-center z-50" id="formPopup">
  <div class="bg-dusk-09 p-4 rounded-lg shadow-lg w-11/12 max-w-xl border border-dusk">
    <h2 class="text-sm font-semibold mb-4 text-white">
        {{label}}
    </h2>
    <form ws-send hx-disabled-elt="this" class="flex flex-col">
      <input type="hidden" name="cmd" value="{{cmd}}">
      {{#if id}}
      <input type="hidden" name="id" value="{{id}}">
      {{/if}}
      <textarea name="content" rows="10" placeholder="Enter your content here..." class="w-full min-h-[150px] mb-4 p-2 border border-dusk-50 rounded resize-y bg-dusk-90 text-white placeholder-dusk-50"></textarea>
      <div class="flex justify-end gap-2">
        <button type="submit" name="action" value="apply_all" class="btn-primary">Apply All</button>
        {{#if id}}
        <button type="submit" name="action" value="apply" class="btn-primary">Apply</button>
        {{/if}}
        <button type="submit" name="action" value="cancel" class="btn-secondary">Cancel</button>
      </div>
    </form>
  </div>
</div>
{{/if}}
</div>
