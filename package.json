{
  "name": "redis-document-agent",
  "version": "0.1.0",
  "main": "server/index.js",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.3.10"
  },
  "scripts": {
    "build:css": "bunx @tailwindcss/cli -i ./styles/styles.css -o ./public/styles.css",
    "build": "bun run build:css && bun build --target=bun . --outdir build/",
    "dev": "bun run dev.ts",
    "dev:server": "bun run --watch .",
    "dev:css": "bunx @tailwindcss/cli -i ./styles/styles.css -o ./public/styles.css --watch",
    "docker": "docker compose down && docker compose up -d --build",
    "docker:redis": "docker compose down && docker compose up -d redis",
    "format": "prettier . --write",
    "start": "bun .",
    "test": "bun test --timeout 15000",
    "ts": "bunx tsc",
    "typecheck": "bun run ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.70",
    "@ai-sdk/google-vertex": "^3.0.118",
    "@ai-sdk/openai": "^2.0.100",
    "@langchain/textsplitters": "^0.1.0",
    "@tavily/core": "^0.5.14",
    "ai": "^5.0.156",
    "connect-redis": "^9.0.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-handlebars": "^8.0.6",
    "express-session": "^1.19.0",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.1",
    "marked": "^16.4.2",
    "redis": "^5.11.0",
    "ulid": "^3.0.2",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.2.21",
    "@types/express-session": "^1.18.2",
    "@types/ws": "^8.5.14",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  }
}
