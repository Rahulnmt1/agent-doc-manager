NODE_ENV=development
LOG_LEVEL=debug
REDIS_URL="redis://localhost:6300"

# Default demo mode loads bundled markdown docs from ./data/documents.
# Set CRAWL_SOURCE=tavily to use live crawl with Tavily instead.
CRAWL_SOURCE=local
CRAWL_LOCAL_LIMIT=5

# Default TTL (in seconds) for Redis-backed memory, documents, and projects.
# Set to -1 to disable expiration.
REDIS_DEFAULT_TTL=86400

# Required for live crawl mode only.
# You can get a free Tavily account + key: https://www.tavily.com/
TAVILY_API_KEY=<TAVILY_API_KEY>

# Required for the default tutorial path.
OPENAI_API_KEY=<OPENAI_API_KEY>

# Optional alternative provider.
#GOOGLE_APPLICATION_CREDENTIALS={"account":"","client_id":"123456788-4kjh455kj4jkh5k3j5h.apps.googleusercontent.com","client_secret":"d-FL95Q19q7MQmFpd7hHD0Ty","quota_project_id":"gcloud-project-id","refresh_token":"1//adsgdfsahgsdhf","type":"authorized_user","universe_domain":"googleapis.com"}
#GOOGLE_CLOUD_PROJECT_ID=gcloud-project-id

# Optional alternative provider. You still need OpenAI or Google for embeddings.
# ANTHROPIC_API_KEY=<ANTHROPIC_API_KEY>
